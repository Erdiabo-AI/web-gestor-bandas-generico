# Copia este fichero a .env y rellena los valores.

# Clave secreta de Flask (sesiones). Genera una aleatoria en produccion:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# Cadena de conexion a PostgreSQL en Neon (usar el host -pooler en serverless):
# postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Entorno (development / production)
FLASK_ENV=development

# Opcional: titulo de la cabecera
# APP_NAME=Gestor de Fichas de control para campañas genérico
